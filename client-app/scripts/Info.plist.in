<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for CloudFSApp.app.
  Tokens @SHORT_VERSION@ / @BUILD_VERSION@ are substituted by scripts/make-app.sh.

  Activation: this is a REGULAR app (no LSUIElement) — it shows a normal window
  and a Dock icon so it can be seen and screenshotted. The app *also* installs a
  MenuBarExtra at runtime, but it remains a regular foreground app.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleExecutable</key>
    <string>CloudFSApp</string>

    <key>CFBundleIdentifier</key>
    <string>dev.cloudfs.client</string>

    <key>CFBundleName</key>
    <string>CloudFS</string>

    <key>CFBundleDisplayName</key>
    <string>CloudFS</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleShortVersionString</key>
    <string>@SHORT_VERSION@</string>

    <key>CFBundleVersion</key>
    <string>@BUILD_VERSION@</string>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- App icon: AppIcon.icns in Contents/Resources (generated by make-icon.swift). -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <!-- Regular foreground app: visible window + Dock icon (NOT LSUIElement). -->
    <key>LSUIElement</key>
    <false/>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- Register the cloudfs:// URL scheme used by SSO callback + copy-link. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.cloudfs.client.deeplink</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>cloudfs</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
