<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Finder Sync extensions MUST be sandboxed; the App Group is the only daemon
     rendezvous the sandbox can reach (the daemon binds finder.sock there). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.cloudfs.client</string>
	</array>
</dict>
</plist>
