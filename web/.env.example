# cloud-fs web — environment (Vite exposes only VITE_*).
# Copy to `.env.local` (gitignored) to override locally.

# Use the in-memory MockApi (offline, no backend). Default is "1" (mock on).
# Set to "0" to talk to the real backend.
VITE_USE_MOCK=1

# Base URL of the backend gateway.
#  - DEV (npm run dev): leave EMPTY. The Vite dev server proxies /v1/* to the
#    local Worker (see VITE_DEV_PROXY_TARGET), so the browser makes same-origin
#    calls — no CORS, and the cfs_session cookie is first-party.
#  - PROD: set to the deployed gateway origin, OR leave empty when the gateway is
#    reverse-proxied at the SAME origin as this SPA.
# Examples:
#   VITE_API_BASE=https://gw.cloud-fs.example
#   VITE_API_BASE=                # same-origin (dev proxy, or same-origin reverse proxy)
VITE_API_BASE=

# DEV-ONLY: where the Vite dev server proxies /v1/* to. Defaults to the local
# Worker at wrangler dev's default port. Not used in production builds.
VITE_DEV_PROXY_TARGET=http://localhost:8787

# Optional: download URL for the cloud-fs Mac app, shown by the "Get the app"
# card (post-/join success screen + Settings). cloud-fs is self-hosted (AGPLv3,
# BYO Cloudflare account) — there's no single canonical download URL, so this is
# deployment-specific. Leave empty to show honest "ask your admin" copy instead
# of a dead download button.
#   VITE_APP_DOWNLOAD_URL=https://cdn.example.com/cloud-fs/CloudFS-latest.dmg
VITE_APP_DOWNLOAD_URL=
